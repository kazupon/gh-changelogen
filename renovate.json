{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base", ":preserveSemverRanges"],
  "labels": ["dependency"],
  "automerge": true,
  "ignoreDeps": [],
  "packageRules": [
    {
      "description": "Keep Vite+ packages aligned",
      "matchDepNames": ["vite", "vite-plus"],
      "matchPackageNames": ["@voidzero-dev/vite-plus-core", "vite-plus"],
      "groupName": "vite-plus",
      "rangeStrategy": "pin"
    }
  ],
  "major": {
    "automerge": false
  }
}
