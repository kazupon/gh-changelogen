{
  "name": "gh-changelogen",
  "version": "1.0.0",
  "description": "Changelog generator for GitHub Releases",
  "keywords": [
    "changelog",
    "github",
    "release"
  ],
  "bugs": {
    "url": "https://github.com/kazupon/gh-changelogen/issues"
  },
  "license": "MIT",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazupon/gh-changelogen.git"
  },
  "funding": "https://github.com/sponsors/kazupon",
  "bin": "./cli.mjs",
  "files": [
    "dist",
    "*.mjs"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "prepack": "vp pack",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp test",
    "release": "bumpp --commit \"release: v%s\" --push --tag",
    "check": "vp check",
    "fix": "vp check --fix",
    "format": "vp fmt --check",
    "format:fix": "vp fmt --write",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "deadcode": "knip",
    "prepare": "vp config"
  },
  "dependencies": {
    "ohmyfetch": "^0.4.18",
    "semver": "^7.3.7",
    "zod": "^3.18.0",
    "zodiarg": "^0.2.1"
  },
  "devDependencies": {
    "@kazupon/vp-config": "^0.5.1",
    "@types/node": "^18.7.14",
    "@types/semver": "^7.3.12",
    "bumpp": "^12.0.0",
    "knip": "^6.16.1",
    "pkg-pr-new": "^0.0.86",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">= 14.18"
  },
  "packageManager": "pnpm@11.18.0"
}
